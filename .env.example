# ===== App =====
APP_ENV=local
APP_NAME=developer-brain-ai
APP_LOG_LEVEL=INFO
APP_LOG_JSON=false

# ===== Database (Postgres + pgvector) =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=dba
POSTGRES_PASSWORD=_change_me_in_prod
POSTGRES_DB=developer_brain
DATABASE_URL=postgresql+asyncpg://dba:_change_me_in_prod@postgres:5432/developer_brain
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ===== Redis (cache + Arq) =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
ARQ_REDIS_URL=redis://redis:6379/0

# ===== Auth =====
JWT_SECRET=_change_me_in_prod_32_chars_min_please
JWT_ALG=HS256
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ===== AI providers =====
AI_PROVIDER_DEFAULT=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=2000
AI_LANGUAGE=pt-BR
AI_WRITING_TONE=desenvolvedor-compartilhando-evolucao

# ===== Storage (local now, S3-ready) =====
STORAGE_KIND=local
STORAGE_LOCAL_ROOT=./data/uploads

# ===== RAG =====
RAG_EMBEDDING_DIM=3072
RAG_TOP_K=6

# ===== News (worker crons, UTC) =====
# news fetch: a cada 4h (0,4,8,12,16,20 UTC); digest: diario 08:00 UTC
NEWS_FETCH_HOUR=0,4,8,12,16,20
NEWS_FETCH_MINUTE=0
NEWS_DIGEST_HOUR=8
NEWS_DIGEST_MINUTE=0
# tenant alvo (single-tenant) — UUID
# IMPORTANTE: deve ser o MESMO tenant do Discord (DISCORD_TENANT_ID), pois a
# aprovacao do digest roda no contexto do bot (RLS) e busca o draft nesse tenant.
NEWS_TENANT_ID=

# ===== Integrations =====
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_TOKEN=
OBSIDIAN_VAULT_PATH=./data/obsidian-vault
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8001/integrations/linkedin/callback

# ===== Messaging channels =====
# Telegram: Bot API (webhook/polling)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_TENANT_ID=
TELEGRAM_POLLING=true
# Discord: Gateway (discord.py). Token do bot + snowflake do canal.
# Requer MESSAGE CONTENT INTENT habilitado no Discord Developer Portal.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_CHANNEL_ID=
DISCORD_TENANT_ID=

# ===== Tenancy / RLS =====
TENANT_DEFAULT_ID=00000000-0000-0000-0000-000000000000